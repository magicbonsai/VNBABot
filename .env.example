# VNBABot environment.
# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Database (Supabase Postgres) — shared with vnba-app ---------------------
# Server-side only. The bot is a long-running process, so the DIRECT connection
# (port 5432) is fine. Switch to the pooled string (port 6543) only if you ever
# run many bot instances. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres:PASSWORD@db.REF.supabase.co:5432/postgres

# --- Discord ----------------------------------------------------------------
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# --- Google Sheets (legacy — still used by not-yet-migrated commands) --------
# Remove once every command reads/writes the DB instead of Sheets.
GOOGLE_SHEETS_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# --- Twitter (rojBot / smithy) ----------------------------------------------
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER=
TWITTER_CONSUMER_KEY_TWO=
TWITTER_CONSUMER_SECRET_TWO=
TWITTER_ACCESS_TOKEN_TWO=
TWITTER_ACCESS_TOKEN_SECRET_TWO=
